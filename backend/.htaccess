# Iran-Daily — Apache Configuration
# Author: THE SAZ (https://github.com/THE-SAZ)

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Route /api/* to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^api/(.*)$ index.php [QSA,L]

    # Route /stream to stream.php
    RewriteRule ^stream$ stream.php [QSA,L]

    # Route /health to health.php
    RewriteRule ^health$ health.php [QSA,L]
</IfModule>

# Block access to sensitive directories
<FilesMatch "\.(json|lock|md)$">
    Require all denied
</FilesMatch>

# Disable directory listing
Options -Indexes

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-Powered-By "Iran-Daily by THE SAZ"
</IfModule>

# Disable gzip for SSE
<IfModule mod_deflate.c>
    SetEnvIf Request_URI "stream" no-gzip
</IfModule>
